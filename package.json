    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "sax": "1.4.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/sax": "1.2.7",
    "typescript": "5.7.3"
  }
}
